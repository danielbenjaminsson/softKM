resource app_signature "application/x-vnd.softKMClient";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
    major  = 1,
    middle = 0,
    minor  = 0,

    variety = B_APPV_DEVELOPMENT,
    internal = 22,

    short_info = "softKMClient",
    long_info = "softKMClient — Haiku-to-Haiku sender"
};

/*
 * Application Icon - shared with the softKM server app so both
 * Haiku binaries present the same Microgeni branding in Tracker
 * and the Deskbar.
 */
resource(101, "BEOS:ICON") #'VICN' import "../../HaikuOS/resources/softKM_icon.hvif";
