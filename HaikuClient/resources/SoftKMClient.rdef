resource app_signature "application/x-vnd.softKMClient";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
    major  = 1,
    middle = 0,
    minor  = 0,

    variety = B_APPV_DEVELOPMENT,
    internal = 0,

    short_info = "softKMClient",
    long_info = "softKMClient — Haiku-to-Haiku sender"
};
